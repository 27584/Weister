{
  "name": "weister-desktop",
  "version": "0.3.1",
  "private": true,
  "description": "Weister 金融投研智能体桌面客户端",
  "main": "main.mjs",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "author": "Weister",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.0"
  },
  "build": {
    "appId": "com.weister.app",
    "productName": "Weister",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.mjs",
      "preload.cjs"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/.venv/**",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/data/checkpoints/**",
          "!**/data/runs/**",
          "!**/data/profiles.json",
          "!**/.pytest_cache/**",
          "!**/.ruff_cache/**",
          "!**/dist/**",
          "!**/*.spec"
        ]
      },
      {
        "from": "../frontend/.next/standalone",
        "to": "frontend"
      },
      {
        "from": "../frontend/.next/static",
        "to": "frontend/.next/static"
      },
      {
        "from": "../frontend/public",
        "to": "frontend/public",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    }
  }
}
