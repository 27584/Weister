confirm-modules-purge=false

# 必须保持扁平（hoisted）依赖布局。
#
# pnpm 默认用符号链接组织 node_modules，而 Next.js `output: "standalone"` 会原样
# 保留这些链接 —— 链接的 target 是**构建机上的绝对路径**（例如
# D:\...\frontend\node_modules\.pnpm\next@16.3.4_...\node_modules\next）。
# 一旦产物离开构建机，这些链接必然断掉（别人机器上不存在该绝对路径），
# server.js 启动即 `Cannot find module 'next'` 并以退出码 1 结束，
# 客户端表现为 "timeout: http://127.0.0.1:3000/ [frontend] exited with code 1"。
#
# hoisted 布局下 node_modules 里是真实文件/目录，Next trace 出来的
# standalone 因而自包含，可以直接打包分发。
node-linker=hoisted
