# ---- LLM 默认配置 ----
# 前端未传配置时的兜底；生产环境建议只写环境变量，不落盘 profiles.json
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

# ---- 服务配置 ----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- 联网搜索源（可选，按优先级降级）----
# 全部留空时自动使用百度 / 必应中国
TAVILY_API_KEY=
BOCHA_API_KEY=
SEARXNG_URL=

# ---- 数据目录 ----
# 留空即用平台标准位置（Windows: %APPDATA%\Weister\data），
# 桌面客户端由 Electron 传入同一路径。只有需要自定义时才设置。
# DATA_DIR=D:\weister-data
